
# HuggingFace token required for pyannote diarization models
HF_TOKEN=

# WhisperX model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v2

# Device: cuda or cpu
DEVICE=cuda

# Compute type for faster-whisper: float16, int8_float16, int8
COMPUTE_TYPE=int8

# Number of frames per second to extract from video
FRAME_RATE=5

# Output directory for SRT files and artefacts
OUTPUT_DIR=output

# Video processing mode: full_frame or user_crop
# full_frame: use VOICECHAT_ROI (calibrated region for the comms panel)
# user_crop: process the entire frame without cropping (video is already cropped)
VIDEO_MODE=full_frame

# Valorant voice-chat ROI as fractions of frame size: x1,y1,x2,y2
# Default targets the left-side comms panel at 1920x1080
VOICECHAT_ROI=0.0,0.15,0.075,0.65

# pHash similarity threshold (lower = stricter). Hamming distance ≤ this value
# counts as a match.
PHASH_THRESHOLD=10

# Debug mode: save ROI-cropped frames as PNG files
DEBUG_FRAMES=false
DEBUG_FRAMES_DIR=debug_frames

# CV Settings
CV_PORTRAIT_THRESHOLD=0.7
CV_MIC_THRESHOLD=0.7
CV_DX_LIMIT=0.1
CV_DY_LIMIT=0.05
CV_TEMPORAL_K=3
CV_TEMPORAL_N=5

# Fusion Settings
FUSION_COVERAGE_THRESHOLD=0.5
FUSION_CONFIDENCE_THRESHOLD=0.8
