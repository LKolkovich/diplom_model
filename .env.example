
# HuggingFace token required for pyannote diarization models
HF_TOKEN=hf_your_token_here

# WhisperX model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v2

# Device: cuda or cpu
DEVICE=cuda

# Compute type for faster-whisper: float16, int8_float16, int8
COMPUTE_TYPE=float16

# Number of frames per second to extract from video
FRAME_RATE=5

# Output directory for SRT files and artefacts
OUTPUT_DIR=output

# Valorant voice-chat ROI as fractions of frame size: x1,y1,x2,y2
# Default targets the left-side comms panel at 1920x1080
VOICECHAT_ROI=0.0,0.15,0.075,0.65

# pHash similarity threshold (lower = stricter). Hamming distance ≤ this value
# counts as a match.
PHASH_THRESHOLD=10
